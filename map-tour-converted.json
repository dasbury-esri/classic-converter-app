        "n-37d87b": {
            "type": "text",
            "data": {
                "type": "h3",
                "text": "Challenger Deep",
                "textAlignment": "start"
            }
        },
        "n-e38555": {
            "type": "text",
            "data": {
                "type": "paragraph",
                "text": "On March 26, 2012, James Cameron made his <a target=\"_blank\" href=\"http://deepseachallenge.com\" style=\"outline: none;\">record-breaking solo dive</a> to the Earth's DEEPEST point, at ~10,900 m or over 6.7 miles. Not since the historic dive of Captain Don Walsh and Jacques Piccard in 1961, had human beings descended this far. PHOTO: <i>Science magazine</i>\n",
                "textAlignment": "start"
            }
        },
        "n-6e756c": {
            "type": "image",
            "data": {
                "image": "r-d92237"
            },
            "config": {
                "size": "standard"
            }
        },
        "n-430cfd": {
            "type": "carousel",
            "config": {},
            "data": {},
            "children": [
                "n-6e756c"
            ]
        },
        "n-000795": {
            "type": "text",
            "data": {
                "type": "h3",
                "text": "Horizon Deep",
                "textAlignment": "start"
            }
        },
        "n-86fcb0": {
            "type": "text",
            "data": {
                "type": "paragraph",
                "text": "The SECOND deepest spot on the planet is <a target=\"new\" href=\"http://dusk.geo.orst.edu/tonga\" style=\"outline: none;\">Horizon Deep in the Tonga Trench</a>, at ~10,600 m deep or over 6.5 miles, dwarfing the U.S. Grand Canyon in area. IMAGE: <i>D Wright</i>",
                "textAlignment": "start"
            }
        },
        "n-062c3c": {
            "type": "image",
            "data": {
                "image": "r-18611c"
            },
            "config": {
                "size": "standard"
            }
        },
        "n-68872b": {
            "type": "carousel",
