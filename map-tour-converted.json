        "n-15a08b": {
            "type": "text",
            "data": {
                "type": "h3",
                "text": "No part of the ocean is unaffected by humans now!",
                "textAlignment": "start"
            }
        },
        "n-908cc8": {
            "type": "text",
            "data": {
                "type": "paragraph",
                "text": "World governments are thus realizing that exploring and studying the ocean need to become higher priorities.",
                "textAlignment": "start"
            }
        },
