        "n-f74fa7": {
            "type": "text",
            "data": {
                "type": "h3",
                "text": "Eastern Samoan Volcanic Province",
                "textAlignment": "start"
            }
        },
        "n-74ec13": {
            "type": "text",
            "data": {
                "type": "paragraph",
                "text": "<a target=\"new\" href=\"http://www.esri.com/news/arcnews/summer11articles/exploring-the-deeper-reefs-and-volcanic-provinces-of-american-samoa.html\">GIS analyses</a> have helped to discover 50 new volcanoes and rift zones in this VERY geologically active part of the world where major earthquakes and tsunamis have caused great devastation. IMAGE: <i>J Roberts, D Wright</i>",
                "textAlignment": "start"
            }
        },
