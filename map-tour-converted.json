        "n-f1eeba": {
            "type": "text",
            "data": {
                "type": "h3",
                "text": "Sidewalk",
                "textAlignment": "start"
            }
        },
        "n-92b962": {
            "type": "text",
            "data": {
                "type": "paragraph",
                "text": "Sunrise streaks the New York Street sidewalk at the north edge of Esri's campus in Redlands, California.",
                "textAlignment": "start"
            }
        },
        "n-5e4c8b": {
            "type": "text",
            "data": {
                "type": "h3",
                "text": "New York Street",
                "textAlignment": "start"
            }
        },
        "n-4330d7": {
            "type": "text",
            "data": {
                "type": "paragraph",
                "text": "The headquarters building, completed in 2010, unifies the campus. New York Street used to bisect the campus, but a portion of the street was closed, and the building straddles the old right of way.",
                "textAlignment": "start"
            }
        },
        "n-124909": {
            "type": "text",
            "data": {
                "type": "h3",
                "text": "Palms",
                "textAlignment": "start"
            }
        },
        "n-89b5a4": {
            "type": "text",
            "data": {
                "type": "paragraph",
                "text": "Stately palm trees line New York Street and frame views of the headquarters building.",
                "textAlignment": "start"
            }
        },
