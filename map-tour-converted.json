        "n-df7b8b": {
            "type": "storycover",
            "data": {
                "type": "minimal",
                "title": "(CONVERSION) Esri Campus Tour",
                "summary": "An early morning walking tour of the Esri campus in Redlands, California",
                "byline": ""
            }
        },
        "n-067dab": {
            "type": "navigation",
            "data": {
                "links": []
            },
            "config": {
                "isHidden": true
            }
        },
        "n-d5c36c": {
            "type": "text",
            "data": {
                "type": "h3",
                "text": "Sidewalk",
                "textAlignment": "start"
            }
        },
        "n-6d90ac": {
            "type": "text",
            "data": {
                "type": "paragraph",
                "text": "Sunrise streaks the New York Street sidewalk at the north edge of Esri's campus in Redlands, California.",
                "textAlignment": "start"
            }
        },
        "n-afe172": {
            "type": "text",
            "data": {
                "type": "h3",
                "text": "New York Street",
                "textAlignment": "start"
            }
        },
        "n-8ddfaa": {
            "type": "text",
            "data": {
                "type": "paragraph",
                "text": "The headquarters building, completed in 2010, unifies the campus. New York Street used to bisect the campus, but a portion of the street was closed, and the building straddles the old right of way.",
                "textAlignment": "start"
            }
        },
        "n-75d14d": {
            "type": "text",
            "data": {
                "type": "h3",
                "text": "Palms",
                "textAlignment": "start"
            }
        },
        "n-9437e9": {
            "type": "text",
            "data": {
                "type": "paragraph",
                "text": "Stately palm trees line New York Street and frame views of the headquarters building.",
                "textAlignment": "start"
            }
        },
